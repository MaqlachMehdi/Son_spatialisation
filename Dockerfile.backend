# Image de l'API FastAPI (src/api/). Le dataset SOFA et les sons sont montés
# en volumes par docker-compose.yml, pas copiés ici (gitignorés, potentiellement
# volumineux) — cf. requirements-api.txt pour le choix des dépendances.

FROM python:3.12-slim

WORKDIR /app

# libgomp1 : requis par scipy/numpy (OpenMP) sur l'image slim, absent par défaut.
RUN apt-get update \
    && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-api.txt .
RUN pip install --no-cache-dir -r requirements-api.txt

COPY src/ ./src/

# dataset/ et sound/ : points de montage (cf. docker-compose.yml), créés ici
# pour que HRTF_SOFA_PATH par défaut (dataset/generic.sofa) résolve même si
# le volume n'est pas encore monté au premier build.
RUN mkdir -p dataset sound

EXPOSE 8000

CMD ["python", "-m", "uvicorn", "api.server:app", "--host", "0.0.0.0", "--port", "8000", "--app-dir", "src"]
