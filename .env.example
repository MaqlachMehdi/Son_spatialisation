# Copier en .env (jamais commité) et adapter les valeurs.

# Postgres — utilisé par docker-compose.yml pour créer le conteneur local,
# et par le backend (DATABASE_URL) pour s'y connecter.
POSTGRES_USER=son_spatialisation
POSTGRES_PASSWORD=changeme
POSTGRES_DB=son_spatialisation

# Chaîne de connexion async (driver asyncpg) utilisée par SQLAlchemy.
DATABASE_URL=postgresql+asyncpg://son_spatialisation:changeme@localhost:5432/son_spatialisation

# Secret de signature des JWT — générer une vraie valeur aléatoire, jamais
# celle-ci. Ex: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=changeme-generate-a-real-secret

# Cookie de session : False en dev (http local), True en production (https).
COOKIE_SECURE=false

# Origine autorisée en CORS pour le frontend.
FRONTEND_ORIGIN=http://localhost:5173